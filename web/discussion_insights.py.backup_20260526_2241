]


def _canonical_mind_map_branch_label(label: str, index: int = 0) -> str:
    """還原 LLM 或截斷標籤為完整子議題名稱。"""
    raw = re.sub(
        r"^[\s★⚙💡♥⚠➤◆●\-\·…\.]+",
        "",
        str(label or "").strip(),
    )
    if not raw or raw in ("...", "…"):
        if 0 <= index < len(_MIND_MAP_BRANCH_ORDER):
            return _MIND_MAP_BRANCH_ORDER[index]
        return "討論重點"
    for canonical in _MIND_MAP_BRANCH_ORDER:
        if canonical in raw or raw in canonical:
            return canonical
    best_label = raw
    best_score = 0
    for canonical, keywords in _MIND_MAP_THEME_BUCKETS:
        score = _theme_score_for_text(raw, keywords)
        if score > best_score:
            best_score = score
            best_label = canonical
    if best_score > 0:
        return best_label
    if len(raw) <= 6 and 0 <= index < len(_MIND_MAP_BRANCH_ORDER):
        return _MIND_MAP_BRANCH_ORDER[index]
    return raw

_PHASE_MIND_LABELS = frozenset(
    {
