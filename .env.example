# 複製為 .env 並填入你的 Key
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# 建立討論室「依主題推薦名人」固定走 OpenAI（需 OPENAI_API_KEY）
TOPIC_FIT_RECOMMEND_TIMEOUT=120
# 開場／辯論成員契合（與推薦分開）：auto | hybrid | semantic | keyword | llm
TOPIC_FIT_BACKEND=auto
TOPIC_FIT_LLM_RERANK=0
TOPIC_FIT_LLM_PREFILTER=keyword
# 1 = 每位名人先 pgvector 語意檢索爬蟲 chunks，再送 OpenAI 打分（推薦預設）
TOPIC_FIT_LLM_USE_VECTOR=1
TOPIC_FIT_LLM_BATCH=8
TOPIC_FIT_LLM_CANDIDATES=24
# 實際送 OpenAI 評分的人數（其餘用資料庫語意分數）
TOPIC_FIT_LLM_SCORE_MAX=18
TOPIC_FIT_LLM_WORKERS=3
TOPIC_FIT_RECOMMEND_TIMEOUT=75
TOPIC_FIT_RAG_TOP_K=3
TOPIC_FIT_SNIPPET_CHARS=700
# 辯論階段至少幾輪（全場循環；高契合名人個人最多 4 輪）
CHAT_MIN_DEBATE_ROUNDS=3
# 圖譜：每 N 則新發言才呼叫 OpenAI 深度分析，其間用即時規則版更新心智圖
INSIGHTS_LLM_EVERY_N=3
TOPIC_FIT_RAG_TOP_K=4
